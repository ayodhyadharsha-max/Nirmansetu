# ==============================================================================
# NirmanSetu Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Never commit real credentials or private keys to source control.
# - Store sensitive keys (SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET) strictly
#   in your secure server environment or Supabase Vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Public Supabase URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Supabase Client Key (Safe for browser client usage with RLS enabled)
# Modern Supabase dashboard naming:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"
# Legacy Supabase naming (supported for backward compatibility):
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Privileged Supabase Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# Used exclusively for background jobs, privileged webhooks, and administrative operations
# Modern Supabase dashboard naming:
SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"
# Legacy Supabase naming (supported for backward compatibility):
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# Direct PostgreSQL Connection URI (Used for migrations and local CLI seed scripts)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_DB_URL="postgresql://postgres:your_password@localhost:54322/postgres"

# ------------------------------------------------------------------------------
# 2. BRAND & MARKETPLACE LOCALIZATION (Fully Configurable)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="NirmanSetu"
NEXT_PUBLIC_BRAND_SHORT_NAME="NirmanSetu"
NEXT_PUBLIC_BRAND_TAGLINE="Ayodhya's On-Demand Building Materials Marketplace"
NEXT_PUBLIC_BRAND_LEGAL_ENTITY="NirmanSetu Tech & Infra Private Limited (Proposed)"
NEXT_PUBLIC_BRAND_CITY="Ayodhya"
NEXT_PUBLIC_BRAND_STATE="Uttar Pradesh"
NEXT_PUBLIC_BRAND_COUNTRY="India"
NEXT_PUBLIC_BRAND_SUPPORT_PHONE="+91 94500 00000"
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="support@nirmansetu.in"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_PINCODE="224001"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (Razorpay India - All amounts processed in integer paise)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Browser & Server)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

# Razorpay Key Secret (Server-side ONLY)
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"

# Webhook signature secret for verifying payment callbacks
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# ------------------------------------------------------------------------------
# 4. MULTI-CHANNEL NOTIFICATIONS & LOGISTICS
# ------------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API (Automated dispatch & Drop-off OTP notifications)
WHATSAPP_BUSINESS_TOKEN="placeholder_meta_whatsapp_cloud_api_token"
META_WHATSAPP_PHONE_NUMBER_ID="placeholder_meta_phone_number_id"

# Resend Transactional Email API (Automated invoices & quotes)
RESEND_API_KEY="placeholder_resend_api_key"

# Administrative API Key (For secure background scripts & webhook reconciliations)
ADMIN_API_KEY="placeholder_admin_secret_key"

# ------------------------------------------------------------------------------
# 5. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://nirmansetu.in"

# Enable demo data indicators (Set to false in production)
NEXT_PUBLIC_ENABLE_DEMO_BADGES="true"
